# ── ShipReady environment ─────────────────────────────────────────
# Copy to .env for local development:  cp .env.example .env

# PostgreSQL connection string (required).
# Local default matches the docker command in the README.
# Production: use the POOLED connection string from Neon / Vercel Postgres.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# OpenAI API key (optional, server-side only — never prefix with NEXT_PUBLIC_).
# Without it, the copilot runs the deterministic local analyst and says so.
OPENAI_API_KEY=

# Override the OpenAI model (optional, defaults to gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini
